# ============================================================
# FinSight AI — Environment Variables
# Copy to .env and fill in your values. Never commit .env.
# ============================================================

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://finsight:password@localhost:5432/finsight_db
SYNC_DATABASE_URL=postgresql://finsight:password@localhost:5432/finsight_db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=your-64-character-random-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# --- External Financial Data APIs ---
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# Financial Modeling Prep: https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=your_fmp_key

# Finnhub: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key

# NewsAPI: https://newsapi.org/register
NEWS_API_KEY=your_news_api_key

# --- AI / LLM ---
# Google Gemini: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (optional fallback): https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key

# --- Storage ---
CHROMADB_PATH=./data/chromadb
MODEL_STORAGE_PATH=./data/models

# --- Email (optional for alerts) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@finsight.ai

# --- Frontend (copy relevant ones to frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=FinSight AI
NEXT_PUBLIC_APP_VERSION=1.0.0
