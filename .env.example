# ============================================================
# FinSight AI — environment variables
# Copy to .env (project root) and edit. EVERYTHING IS OPTIONAL:
# with no .env the app runs on SQLite, an in-memory cache, live
# Yahoo Finance data (simulated fallback) and offline AI mode.
# Never commit .env.
# ============================================================

# --- App ---
ENVIRONMENT=development
# Required in production. In development a random key is generated and stored in backend/data/.secret_key
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# --- Database ---
# Default: SQLite file at backend/data/finsight.db
# PostgreSQL example (also: pip install -r backend/requirements-postgres.txt):
# DATABASE_URL=postgresql+asyncpg://finsight:finsight@localhost:5432/finsight_db

# --- Cache ---
# Default: in-memory. Redis example:
# REDIS_URL=redis://localhost:6379/0

# --- Market data ---
# auto = live Yahoo Finance with simulated fallback · live = live only · demo = simulated only (offline)
MARKET_DATA_MODE=auto

# --- AI (LLM) ---
# auto = Gemini → Groq → OpenAI (whichever has a key) → local Ollama → offline analyst
LLM_PROVIDER=auto
# Local, free, offline: install Ollama (make ai-setup) — no key needed
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Google Gemini (free tier): https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq (free tier, very fast): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Sentiment ---
# auto = FinBERT transformer (downloads ~440 MB once, loads in the background), lexicon = rule-based only
SENTIMENT_BACKEND=auto

# --- Optional news providers (Yahoo Finance news is used by default, no key needed) ---
FINNHUB_API_KEY=
NEWS_API_KEY=

# --- Background jobs ---
ALERT_CHECK_INTERVAL_SECONDS=300

# --- Email for password-reset links (optional; without SMTP the link is shown in development) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@finsight.local
